{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "KnightCode Workbench",
  "author": "KnightCode",
  "themes": [{
    "name": "KnightCode Workbench",
    "appearance": "dark",
    "style": {
      "background": "#0a0805",
      "surface.background": "#100c07",
      "elevated_surface.background": "#191108",
      "border": "#3d2913",
      "border.variant": "#281b0d",
      "border.focused": "#ea922f",
      "border.selected": "#be7529",
      "border.transparent": "#00000000",
      "border.disabled": "#2a2015",
      "element.background": "#1b130a",
      "element.hover": "#30200d",
      "element.active": "#472b0c",
      "element.selected": "#512d0d",
      "element.disabled": "#130f09",
      "ghost_element.background": "#00000000",
      "ghost_element.hover": "#2b1c0c",
      "ghost_element.active": "#472b0c",
      "ghost_element.selected": "#512d0d",
      "ghost_element.disabled": "#130f09",
      "drop_target.background": "#ff9c3240",
      "text": "#f0e9df",
      "text.muted": "#b5a68f",
      "text.placeholder": "#89765c",
      "text.disabled": "#695941",
      "text.accent": "#ffa83d",
      "icon": "#eee6d9",
      "icon.muted": "#baa98f",
      "icon.disabled": "#695941",
      "icon.placeholder": "#89765c",
      "icon.accent": "#ffa83d",
      "title_bar.background": "#0b0804",
      "title_bar.inactive_background": "#0a0805",
      "status_bar.background": "#0c0905",
      "toolbar.background": "#0c0905",
      "tab_bar.background": "#0c0905",
      "tab.inactive_background": "#0c0905",
      "tab.active_background": "#191108",
      "panel.background": "#0b0805",
      "panel.focused_border": "#bb762c",
      "pane.focused_border": "#bb762c",
      "search.match_background": "#e8973345",
      "search.active_match_background": "#ffb74860",
      "scrollbar.thumb.background": "#bd8b3e40",
      "scrollbar.thumb.hover_background": "#bd8b3e70",
      "scrollbar.thumb.border": "#00000000",
      "scrollbar.track.background": "#00000000",
      "scrollbar.track.border": "#281b0d",
      "editor.background": "#0b0906",
      "editor.foreground": "#eee6db",
      "editor.gutter.background": "#0b0906",
