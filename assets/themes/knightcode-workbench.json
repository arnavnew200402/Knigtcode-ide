      "editor.highlighted_line.background": "#ff9c3218",
      "editor.line_number": "#715a3b",
      "editor.active_line_number": "#ffa83d",
      "editor.hover_line_number": "#d3b890",
      "editor.invisible": "#56452f",
      "editor.wrap_guide": "#ff9c3212",
      "editor.active_wrap_guide": "#ff9c3228",
      "editor.document_highlight.read_background": "#ff9c3218",
      "editor.document_highlight.write_background": "#ff9c3228",
      "terminal.background": "#080603",
      "terminal.foreground": "#e8dcc6",
      "terminal.bright_foreground": "#fff0d4",
      "terminal.dim_foreground": "#89765c",
      "terminal.ansi.black": "#171007",
      "terminal.ansi.bright_black": "#89765c",
      "terminal.ansi.red": "#ef8b86",
      "terminal.ansi.bright_red": "#ffa39d",
      "terminal.ansi.green": "#9cc89e",
      "terminal.ansi.bright_green": "#b5dfad",
      "terminal.ansi.yellow": "#e8bb72",
      "terminal.ansi.bright_yellow": "#f3cf91",
      "terminal.ansi.blue": "#91b4d5",
      "terminal.ansi.bright_blue": "#b0cdeb",
      "terminal.ansi.magenta": "#c1a1d4",
      "terminal.ansi.bright_magenta": "#dac0ed",
      "terminal.ansi.cyan": "#8ec8bc",
      "terminal.ansi.bright_cyan": "#a8ded2",
      "terminal.ansi.white": "#e8dcc6",
      "terminal.ansi.bright_white": "#fff0d4",
      "link_text.hover": "#ffc16c",
      "version_control.added": "#9cc89e",
      "version_control.modified": "#e8bb72",
      "version_control.deleted": "#ef8b86",
      "version_control.word_added": "#9cc89e33",
      "version_control.word_deleted": "#ef8b8633",
      "version_control.conflict_marker.ours": "#9cc89e1a",
      "version_control.conflict_marker.theirs": "#91b4d51a",
      "players": [{ "cursor": "#ffa83d", "background": "#ffa83d", "selection": "#ffa83d38" }],
      "accents": ["#ffa83d", "#91b4d5", "#9cc89e", "#c1a1d4", "#e8bb72", "#8ec8bc"],
      "syntax": {
        "attribute": { "color": "#e8bb72" },
        "boolean": { "color": "#ffa83d" },
        "comment": { "color": "#89765c", "font_style": "italic" },
        "comment.doc": { "color": "#b5a68f" },
        "constant": { "color": "#e8bb72" },
        "constructor": { "color": "#91b4d5" },
        "function": { "color": "#91b4d5" },
        "keyword": { "color": "#c1a1d4" },
        "number": { "color": "#ffa83d" },
        "operator": { "color": "#c1a1d4" },
        "punctuation": { "color": "#b5a68f" },
        "string": { "color": "#9cc89e" },
        "string.escape": { "color": "#8ec8bc" },
        "tag": { "color": "#ffa83d" },
        "type": { "color": "#8ec8bc" },
        "variable": { "color": "#eee6db" },
        "variable.special": { "color": "#ffa83d" },
        "diff.plus": { "color": "#9cc89e" },
        "diff.minus": { "color": "#ef8b86" }
      }
    }
  }]
}
